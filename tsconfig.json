{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "resolveJsonModule": true,
    "strict": true,
    "paths": {
      "#/*": ["./*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "src/types/**/*.ts",
    "uniwind-types.d.ts",
    "expo-env.d.ts"
  ]
}
